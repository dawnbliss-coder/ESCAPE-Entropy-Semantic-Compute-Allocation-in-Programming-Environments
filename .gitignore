# Personal handoff/status logs
PLAN.md
docs/DIVYANSH_HANDOFF.md
docs/IMPL_STATUS.md
docs/MID_HANDOFF.md
docs/MID_SUBMISSION_C.md
docs/RUN_SCORER.md

# Stream B: frozen corpus & derived artifacts are large/regenerable — do not commit.
# corpus/ uses `corpus/*` (not `corpus/`) so the manifest exception below actually
# works — git can't apply a `!` exception to a file inside a directory that's ignored
# as a whole, it has to be the directory's *contents* that are ignored instead.
corpus/*
!corpus/manifest.parquet
adversarial/
structure/
whitespace/
memory_regions/
identifiers/
!golden_fixtures/

# Stream A / Stream C: venv, fetched model weights, bulk per-file outputs and logs are
# large/regenerable — do not commit. Small metadata (runs.json, per-run status manifests,
# results/ tables and manifests) stays committed.
.venv_a/
checkpoints/
entropies/
boundaries/
bpp_summary.parquet
runs/*/logs/
*.lock
.pytest_cache/

# Isolated Ada-only C test dependencies (user-approved install).
/.c-deps/

# Project report PDF (source stays untracked; the PDF is the tracked deliverable).
!reports/Trimax-Mid-Report.pdf
!results/ada/*.log

# Final Ada run (scripts/ada_final): environments, model data and O5 inputs are regenerable.
.venv_b/
.deps-c/
.nltk_data/
analysis_regions/
# Ada job logs and the job ledger are kept as evidence for every reported number.
!results/final/logs/
!results/final/logs/*

# Local credentials and submission tooling
.secrets
*.secrets
.env
.env.*
.venv_c/
.tools/
*.synctex.gz
errors-*.json
!docs/proposal/*.pdf
!docs/proposal/*.tex
# O5 design matrices are large and regenerable (`python -m escape_scoring o5`).
results/final/*/o5*/o5_design.csv

# Extension corpus (teacher-student pool): large and regenerable, keep only the manifest and data note.
corpus_ext/*
!corpus_ext/manifest_ext.parquet
!corpus_ext/DATA_NOTE.json
!corpus_ext/holdout_manifest.parquet

# Mid-submission report build pipeline (sources kept from local history):
# keep the LaTeX/bib sources and bundled ACL style; build outputs stay ignored.
!reports/mid_submission/*.tex
!reports/mid_submission/*.bib
!reports/mid_submission/vendor/acl.sty
!reports/mid_submission/vendor/acl_natbib.bst
!reports/mid_submission/generated/*
reports/mid_submission/evidence/
reports/mid_submission/build/
reports/mid_submission/validation/

# Final-submission report and viva slides (same scheme as the mid-submission block): keep the
# LaTeX/bib sources, the bundled ACL style, the two deliverable PDFs and generated/ (macros, tables and
# figures from build_final.py, so the LaTeX compiles without rerunning it); build outputs stay ignored.
!reports/final_submission/*.tex
!reports/final_submission/*.bib
!reports/final_submission/vendor/acl.sty
!reports/final_submission/vendor/acl_natbib.bst
!reports/final_submission/Trimax-Final.pdf
!reports/final_submission/slides/*.tex
!reports/final_submission/slides/Trimax-Final-Viva.pdf
!reports/final_submission/generated/*
reports/final_submission/build/
reports/final_submission/slides/build/
!reports/final_submission/validation/*
# Adapted-teacher checkpoint (99.5M params, ~400 MB): regenerable with scripts/ada_distill/adapt_teacher.sbatch.
results/adapt/*/student.pt

# Final submission archive (103 MB, over GitHub's 100 MB file limit); rebuild with scripts/package_final.sh
Trimax-Final.zip

# Figures and job output referenced from the docs.
!results/figures/*.pdf
!results/distill/repro_39379/*.out
